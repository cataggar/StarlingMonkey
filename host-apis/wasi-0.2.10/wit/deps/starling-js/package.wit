package starling:js;

interface api {
  record point {
    x: s32,
    y: s32,
  }

  // A nested aggregate: a record embedding another record plus an exact
  // 64-bit field, used to prove the native typed dispatch path handles
  // aggregates without JSON and without losing precision above 2^53.
  record big-point {
    p: point,
    id: u64,
  }

  add: func(a: u32, b: u32) -> u32;
  greet: func(name: string) -> string;
  notify: func(message: string);
  move: func(point: point, dx: s32, dy: s32) -> point;
  maybe: func(value: option<u32>) -> option<u32>;

  // Exact 64-bit round trips beyond 2^53 (JSON numbers lose precision here;
  // the native typed dispatch path carries them as JavaScript BigInt).
  big-add: func(a: u64, b: u64) -> u64;
  big-sub: func(a: s64, b: s64) -> s64;
  // Nested aggregate carrying an exact u64 field alongside a nested record.
  tag-point: func(p: point, id: u64) -> big-point;

  // A record combining a string field with an exact u64 field: this is the
  // shape that actually exercises the native-dispatch UAF fix (the string
  // and the u64 both live in the same decoded result, so the string must
  // survive past the point where the C++ NativeArena backing it is freed).
  record labeled-id {
    label: string,
    id: u64,
  }
  label-id: func(label: string, id: u64) -> labeled-id;
  nul-label: func(id: u64) -> labeled-id;

  // Optional 64-bit round trips (both `some` and `none`), decoded from the
  // "bare tag, no option_some wrapper" shape that decode_from_js actually
  // produces for a present JS value.
  maybe-big: func(value: option<u64>) -> option<u64>;
  maybe-signed: func(value: option<s64>) -> option<s64>;

  // list<u64>: exercises the native LIST tag end to end (JS array in,
  // JS array out), including exact values beyond 2^53.
  sum-list: func(values: list<u64>) -> u64;
  echo-list: func(values: list<u64>) -> list<u64>;

  // Deliberately returns the wrong JS type (a string) where a u64 is
  // expected, to prove decodeNative traps instead of silently coercing to
  // zero/false.
  wrong-type: func() -> u64;

  // ---------------------------------------------------------------------
  // promise-sync roadmap phase: a synchronous export's JS implementation is
  // allowed to return a Promise (or a thenable); the bridge pumps the
  // engine's event loop until it settles, then lowers the fulfilled value
  // exactly like a directly-returned one. See runtime/js_dispatch.cpp's
  // `resolve_promise_like`.

  // Already-settled by the time the export returns (`Promise.resolve(...)`,
  // no `await`): JSON path (u32 stays representable exactly).
  promise-resolve-add: func(a: u32, b: u32) -> u32;
  // A genuine `async function` awaiting a chain of plain (non-timer)
  // microtasks/nested awaits before returning -- JSON path.
  promise-add: func(a: u32, b: u32) -> u32;
  // Rejects (via a thrown `Error`) after an `await`; must surface as a trap
  // carrying the rejection's message/stack on stderr, not silently decode.
  promise-reject: func() -> u32;
  // A non-Promise "thenable" object (`{ then(resolve) { ... } }`); must be
  // driven to completion exactly like a real Promise per the same duck test
  // `await`/`Promise.resolve` use.
  thenable-add: func(a: u32, b: u32) -> u32;
  // Settles only once a `setTimeout` callback fires: exercises the queued
  // async-task (not just microtask) side of the pump loop.
  promise-timeout-add: func(a: u32, b: u32) -> u32;
  // `void` result reached via a Promise (resolves `undefined`).
  promise-notify: func(message: string);
  // `Promise.resolve` of a typed nested record -- JSON path (point has no
  // 64-bit fields), proving the settled value re-enters the *same* typed
  // conversion a direct record return would use.
  promise-resolve-point: func(point: point, dx: s32, dy: s32) -> point;
  // Deliberately never settles (`new Promise(() => {})`, no executor-side
  // resolve/reject and nothing else queued): must trap deterministically
  // (a "no progress" diagnostic) rather than hang the host.
  promise-deadlock: func() -> u32;

  // Same set of cases again, but for types that force the typed native
  // (BigInt) dispatch path instead of JSON, proving Promise-settling feeds
  // into *that* conversion too, exactly.
  promise-resolve-big-add: func(a: u64, b: u64) -> u64;
  promise-big-add: func(a: u64, b: u64) -> u64;
  promise-reject-big: func() -> u64;
  // --- numeric wraparound (matches ComponentizeJS/ECMAScript, not a trap) --
  // A JS export's own return value that is a Number/BigInt of the *correct
  // kind* but out of range, negative, fractional, or non-finite for the
  // declared WIT integer type wraps modulo 2**bitwidth (ToInt32/ToUint32-
  // family for narrower widths, ToBigInt64/ToBigUint64 for u64/s64) -- it is
  // not a trap -- empirically re-verified against the pinned ComponentizeJS
  // 0.21.0 reference itself, not assumed from the spec (see
  // tests/compat/fixtures/integers-64bit's "sum-list-basic" case and
  // tests/compat/reference). Only a genuinely wrong *kind* (e.g. a string
  // where a number/BigInt is required) still traps -- see `wrong-type`
  // above. `wrap-check` bundles several narrow-width fields alongside a
  // u64/s64 field so the whole record is forced through the native
  // (non-JSON) dispatch path, the same way `tag-point`/`labeled-id` are.
  record wrap-check {
    overflow-u8: u8,
    negative-u8: u8,
    fractional-u8: u8,
    overflow-s32: s32,
    negative-u64: u64,
    overflow-s64: s64,
  }
  wrap-numbers: func() -> wrap-check;

  // --- char --------------------------------------------------------------
  // `char` and `u32` both lower, under the default bindgen, to a bare Zig
  // `u32`; the `--dispatch`-mode `wit_types.Char` wrapper (see
  // component_bindgen.zig) is what lets js_dispatch.zig tell them apart and
  // encode/decode `char` as a single-codepoint JS string instead of a
  // Number.
  echo-char: func(c: char) -> char;
  // JS returns a multi-codepoint string, or a non-string, where exactly one
  // Unicode scalar value is required.
  wrong-type-char: func() -> char;
  invalid-char-multi-codepoint: func() -> char;

  // --- list<u8> vs string --------------------------------------------------
  // `list<u8>` and `string` both lower, under the default bindgen, to a
  // bare Zig `[]const u8`; the `--dispatch`-mode `wit_types.ByteList`
  // wrapper is what lets js_dispatch.zig encode/decode `list<u8>` as a
  // genuine JS `Uint8Array` instead of `string`'s UTF-8 text convention.
  echo-bytes: func(data: list<u8>) -> list<u8>;
  bytes-len: func(data: list<u8>) -> u32;
  // JS returns neither a Uint8Array nor a plain Array.
  wrong-type-bytes: func() -> list<u8>;

  // --- tuple ---------------------------------------------------------------
  swap-pair: func(pair: tuple<u32, string>) -> tuple<string, u32>;
  wrong-type-tuple: func() -> tuple<u32, u32>;

  // --- enum ------------------------------------------------------------
  enum direction {
    north,
    south,
    north-east,
  }
  echo-direction: func(d: direction) -> direction;
  // JS returns a string that isn't one of the enum's case labels.
  invalid-enum-case: func() -> direction;
  // JS returns a non-string where the enum's string encoding is expected.
  wrong-type-enum: func() -> direction;

  // --- flags -----------------------------------------------------------
  flags perms {
    can-read,
    can-write,
    can-execute,
  }
  echo-perms: func(p: perms) -> perms;
  // JS returns an object missing one of the three required boolean labels.
  missing-flags-property: func() -> perms;
  // JS returns a non-object where the flags object is expected.
  wrong-type-flags: func() -> perms;

  // --- variant -----------------------------------------------------------
  variant shape {
    circle(u32),
    square(u32),
    point,
  }
  echo-shape: func(s: shape) -> shape;
  // JS returns a `{tag, val}` object whose `tag` doesn't name any case.
  invalid-variant-tag: func() -> shape;
  // JS returns a non-object where the `{tag, val}` shape is expected.
  wrong-type-variant: func() -> shape;

  // --- result<T, E> --------------------------------------------------------
  // Nested (argument/field) position: JS-visible as the same `{tag, val}`
  // object every other variant uses.
  record wrapped-result {
    r: result<u32, string>,
  }
  echo-wrapped-result: func(w: wrapped-result) -> wrapped-result;

  // Top-level export return-type position: ComponentizeJS's "return means
  // Ok, throw means Err" calling convention applies only here, not to the
  // nested `wrapped-result.r` field above.
  divide: func(a: u32, b: u32) -> result<u32, string>;
  // `err` case where E is `void`: JS signals failure by throwing anything.
  checked-negate: func(value: s32) -> result<s32>;

  // --- naming/version edge cases -------------------------------------------
  // Multi-word WIT identifiers: record fields/flags labels/export names
  // become camelCase JS identifiers; enum case labels/variant tags stay
  // their original kebab-case spelling as a string *value*.
  record multi-word-record {
    first-value: u32,
    second-value: string,
  }
  echo-multi-word-record: func(r: multi-word-record) -> multi-word-record;

  flags multi-word-flags {
    can-read-write,
    can-execute-only,
  }
  echo-multi-word-flags: func(f: multi-word-flags) -> multi-word-flags;

  enum multi-word-enum {
    north-east,
    south-west,
  }
  echo-multi-word-enum: func(e: multi-word-enum) -> multi-word-enum;

  variant multi-word-variant {
    left-turn(u32),
    right-turn(u32),
  }
  echo-multi-word-variant: func(v: multi-word-variant) -> multi-word-variant;

  // A kebab-case export name whose JS implementation is *only* defined
  // under its camelCase spelling (not the literal kebab string) -- proves
  // `resolve_export_function`'s camelCase fallback actually engages, not
  // just that the literal kebab lookup still works (every other export
  // above is implemented under its literal kebab name).
  multi-word-echo: func(value: u32) -> u32;
}

world js-exports {
  export api;
}
