.{
    .name = .starlingmonkey,
    .version = "0.3.0",
    .fingerprint = 0x990a2f6e2fa7fb45,
    .minimum_zig_version = "0.17.0",

    // NOTE: These are host-specific prebuilt tool tarballs (x86_64-linux only for
    // now). A complete port needs per-host variants selected via b.lazyDependency.
    // Mirrors cmake/{binaryen,wasm-tools,weval,wasmtime}.cmake.
    .dependencies = .{
        .binaryen = .{
            .url = "https://github.com/WebAssembly/binaryen/releases/download/version_123/binaryen-version_123-x86_64-linux.tar.gz",
            .hash = "N-V-__8AADnP4RLTHueblJvHO_umKT0px7N7v0VWFBu-o0MK",
            .lazy = true,
        },
        .@"wasm-tools" = .{
            .url = "https://github.com/bytecodealliance/wasm-tools/releases/download/v1.235.0/wasm-tools-1.235.0-x86_64-linux.tar.gz",
            .hash = "N-V-__8AACbjNwH7u3Z4JI3s4jFc9AynPC1AM0jb5MMubpXt",
            .lazy = true,
        },
        .weval = .{
            .url = "https://github.com/bytecodealliance/weval/releases/download/v0.4.1/weval-v0.4.1-x86_64-linux.tar.xz",
            .hash = "N-V-__8AAEenqwEbgblk_u10bu6PFSSAfv0wdz86DwvEExu5",
            .lazy = true,
        },
        .wasmtime = .{
            .url = "https://github.com/bytecodealliance/wasmtime/releases/download/v42.0.1/wasmtime-v42.0.1-x86_64-linux.tar.xz",
            .hash = "N-V-__8AAA3KCgQaOf7fOhpQGN_vZKVJxFxqR_n1pGn2Z0S9",
            .lazy = true,
        },
        // sync-value-parity: temporarily pinned to a local worktree
        // (/work/wabt-sync-value-parity, cataggar/wabt commit
        // 5ee61e0787f95b43593111846eff9931746ab0ea on branch
        // feat/sync-value-parity-types) rather than a pushed git+https
        // commit, per this phase's WABT-coordination constraint: WABT
        // changes are developed in a dedicated worktree/branch and must
        // not be pushed/posted from here. Once that commit is pushed
        // upstream, replace this with a git+https pin (matching the
        // previous entry's shape) and drop this comment.
        .wasip3 = .{
            .path = "../wabt-sync-value-parity",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "builtins",
        "runtime",
        "host-apis",
        "crates",
        "include",
        "deps",
        "LICENSE",
    },
}
