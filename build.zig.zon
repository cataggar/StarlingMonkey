            .hash = "N-V-__8AACbjNwEv1iqZzcX1Qz8UAMhdgq7JN5ES-HSQrxML",
            .lazy = true,
        },
        .weval = .{
            .url = "https://github.com/bytecodealliance/weval/releases/download/v0.4.1/weval-v0.4.1-x86_64-linux.tar.xz",
            .hash = "N-V-__8AAEenqwHFOFkilUp1QXeqpfqbvC3eRiCpOT4TYSsT",
