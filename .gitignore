/deps/rust-staticlib-build/
/deps/mozconfig-zig

# Compatibility harness (tests/compat): Python bytecode cache and the
# opt-in reference mode's Node.js dependencies/build output.
__pycache__/
tests/compat/reference/node_modules/
tests/compat/reference/.jco-out/
tests/compat/reference/.node-cache/
tests/compat/reference/.component-cache/
tests/compat/reference/contracts/.scratch/

# Feature-selection (cataggar/StarlingMonkey#6 Phase 6): the opt-in
# ComponentizeJS reference probe's Node.js dependencies/scratch output, and
# scratch build prefixes used by tests/feature-selection/run-runtime-tests.sh.
tests/feature-selection/reference/node_modules/
tests/feature-selection/reference/.node-cache/
tests/feature-selection/reference/.scratch/
tests/feature-selection/reference/actual-import-surfaces.json
tests/feature-selection/.build/

# Compatibility harness runtime bridge mode (tests/compat/runtime): the
# patched wabt build, per-fixture build/componentize cache, and the
# compat-invoker Rust crate's build output. Cargo.lock IS committed (not
# ignored) for compat-invoker's own build reproducibility.
tests/compat/runtime/.wabt-cache/
tests/compat/runtime/.cache/
tests/compat/runtime/invoker/target/
