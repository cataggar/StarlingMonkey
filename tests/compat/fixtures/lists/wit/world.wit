package starling:js;

// Phase 0 compatibility fixture: list<T> arguments/results for numeric,
// string and boolean element types.
interface api {
   sum: func(values: list<u32>) -> u32;
   reverse: func(values: list<string>) -> list<string>;
   identity: func(values: list<bool>) -> list<bool>;
}

world js-exports {
  export api;
}
