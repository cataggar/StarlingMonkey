package compat:options;

// Phase 0 compatibility fixture: option<T> arguments/results for a numeric,
// string and record payload. See manifest.json known_deviations
// "option-none-representation" for how "none" differs between the current
// Zig/WABT JSON bridge (JS `null`) and the pinned ComponentizeJS reference
// (JS `undefined`); this fixture's JS is written portably (`== null`) so the
// same source produces matching observable behavior under both.
world js-exports {
  record point {
    x: s32,
    y: s32,
  }

  export maybenumber: func(value: option<u32>) -> option<u32>;
  export maybestring: func(value: option<string>) -> option<string>;
  export maybepoint: func(value: option<point>) -> option<point>;
}
