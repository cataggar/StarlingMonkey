package starling:js;

// Phase 0 compatibility fixture: boolean arguments/results, including a
// many-argument (3-bool) case. See ../../manifest.json for its call cases.
interface api {
   negate: func(value: bool) -> bool;
   both: func(a: bool, b: bool) -> bool;
   either: func(a: bool, b: bool) -> bool;
   majority: func(a: bool, b: bool, c: bool) -> bool;
}

world js-exports {
  export api;
}
