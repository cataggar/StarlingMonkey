package starling:js;

// Phase 0 compatibility fixture: records, including a record nested inside
// another record (rectangle.topleft/bottomright are `point` records). Field
// and type names are deliberately single-word (no kebab-case) because
// kebab-case identifier handling is out of scope until Phase 2 (see
// manifest.json feature_matrix).
interface api {
  record point {
    x: s32,
    y: s32,
  }

  record rectangle {
    topleft: point,
    bottomright: point,
  }

   translate: func(point: point, dx: s32, dy: s32) -> point;
   area: func(rect: rectangle) -> s32;
   identity: func(point: point) -> point;
}

world js-exports {
  export api;
}
