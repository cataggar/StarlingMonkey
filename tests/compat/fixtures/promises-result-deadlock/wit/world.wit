package starling:js;

// Integration fixture (feat/js-bridge-parity-integration): a Promise that
// never settles at all, returned from a top-level WIT `result<T, E>`
// export. Kept as its own single-case fixture for the same reason as
// 'promises-rejected'/'promises-deadlock': a Wasmtime component instance
// that has trapped once is poisoned for any further call in the same
// store.
interface api {
   divide-async: func(a: u32, b: u32) -> result<u32, string>;
}

world js-exports {
  export api;
}
