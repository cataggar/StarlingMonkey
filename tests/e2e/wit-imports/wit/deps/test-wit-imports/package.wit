// wit-imports E2E fixture: a self-contained package declaring both a
// host-provided *imported* interface (`host`) and the fixture's own JS
// *exported* interface (`api`), used by tests/e2e/wit-imports/run.sh.
//
// This directory is deliberately isolated (no cross-package `use`) so it
// can be pointed at directly by both:
//   * `wasip3-bindgen --wit <this dir> --world js-exports --dispatch
//     js_dispatch --js-imports` (generates the Zig-side typed import
//     wrappers + the JS-callable reverse bridge for `host`, plus the
//     existing export-shell/dispatch codegen for `api`), and
//   * this fixture's own copy of the full `js-dispatch` world
//     (../js-dispatch.wit), which imports `test:wit-imports/host@1.2.3`
//     and exports `test:wit-imports/api@1.2.3` alongside the usual WASI
//     surface, so `wabt component embed --world js-dispatch` gives the
//     resulting component a genuine, Wasmtime-linkable custom import.
//
// `api` and `host` intentionally do NOT share types via `use` -- each
// declares its own nominally-independent copies of every shared shape
// (`point`, `color`, `permissions`, `shape`). The JS glue in component.js
// bridges between them dynamically by JS value shape (object/array/string/
// boolean), which is all js_dispatch's untyped encode_to_js/decode_from_js
// pair needs; no WIT-level type sharing across interfaces is required for
// two interfaces to interoperate through JS.
//
// Every function below is wired all the way through the reverse
// (JS-imports) bridge using cataggar/wabt's merged `--js-imports` codegen
// (see build.zig.zon's `.wasip3` pin): `nativeBridgeSupported` in
// build/bindgen/component_bindgen.zig accepts every WIT type used here
// (bool/integers/f32/f64/char/string/option<T>/list<T> (including a direct
// `list<u8>`, bridged as `wit_types.ByteList`)/tuple/record/variant/enum/
// flags (<=32 labels)/result<T,E>, recursively) and `lowerParams` lowers
// every one of them (including `char` and a direct `list<u8>` parameter)
// through the generic, reflection-based `lowerAggregateParam` path. The
// World-level functions are bridged as ComponentizeJS-compatible ESM default
// imports (module=<WIT function>, export=default) over canonical `$root` core
// imports. The only WIT shapes this bridge does not support are resources,
// async imports, and a `flags` type with more than 32 labels -- see
// tests/compat/manifest.json's
// `wit-imports-flags-over-32-labels-unsupported` known_deviation.
package test:wit-imports@1.2.3;

interface host {
    record point {
        x: u32,
        y: u32,
    }

    // Exact s64/u64 BigInt round trips through the reverse (import) bridge.
    add: func(a: s64, b: s64) -> s64;
    sum-list: func(xs: list<u64>) -> u64;

    // string lifting/lowering.
    greet: func(name: string) -> string;

    // A nested record argument/result.
    scale: func(p: point, factor: u32) -> point;

    // Always traps host-side; used to prove a real Wasmtime host trap
    // propagates all the way out through the JS import call and the
    // enclosing JS export call as a genuine wasm trap, not a catchable
    // JS exception.
    boom: func() -> u32;

    // A WIT import with no result: JavaScript must observe exactly
    // `undefined` from calling this (never `false`/`null` -- see
    // js_dispatch.h's `STARLING_JS_UNDEFINED`/js_dispatch.zig's
    // `NativeTag.undefined_`). `note-count` is a second, side-channel host
    // import that lets the test prove `note`'s host implementation
    // genuinely ran (its observable side effect: incrementing a host-side
    // counter) rather than merely returning without error.
    note: func();
    note-count: func() -> u32;

    // Nesting: a `list` of `list<u32>`s, proving composite-of-composite
    // types round-trip through the reverse bridge, not just single-level
    // types.
    sum-nested-lists: func(rows: list<list<u32>>) -> u32;

    // -- advanced synchronous value types (integration requirement 5: WIT
    // imports must support every synchronous type the native bridge
    // handles for exports -- see tests/compat/fixtures/advanced-types/ for
    // the export side of the same type set) --

    // `char`: shifts the codepoint by one (proves real host computation,
    // not a bare passthrough) and its `option<char>` counterpart (`none`
    // stays `none`; `some` shifts the same way).
    identity-char: func(c: char) -> char;
    identity-option-char: func(c: option<char>) -> option<char>;

    // `list<u8>` (bytes): a genuine JS `Uint8Array` on the JS side of this
    // bridge (see component.js's shape assertion). `sum-bytes` proves a
    // direct `list<u8>` *parameter* lowers correctly; `xor-bytes` proves a
    // direct `list<u8>` *result* lifts correctly; `identity-optional-bytes`
    // covers the nested/optional case (`list<u8>` inside an `option<T>`).
    sum-bytes: func(bytes: list<u8>) -> u32;
    xor-bytes: func(bytes: list<u8>, key: u8) -> list<u8>;
    identity-optional-bytes: func(bytes: option<list<u8>>) -> option<list<u8>>;

    // `tuple`: swaps position and type, and transforms both elements
    // (increments the number, upper-cases the string) to prove real host
    // computation rather than a bare positional passthrough.
    swap-tuple: func(t: tuple<u32, string>) -> tuple<string, u32>;

    // `enum`: cycles red -> green -> blue -> red, and its `option<enum>`
    // counterpart.
    enum color {
        red,
        green,
        blue,
    }
    next-color: func(c: color) -> color;
    next-option-color: func(c: option<color>) -> option<color>;

    // `flags` (3 labels, well under the 32-label limit WABT's native
    // bridge supports -- see the package doc comment's
    // `wit-imports-flags-over-32-labels-unsupported` reference): flips
    // every bit, and its `option<flags>` counterpart.
    flags permissions {
        read,
        write,
        execute,
    }
    toggle-permissions: func(p: permissions) -> permissions;
    toggle-option-permissions: func(p: option<permissions>) -> option<permissions>;

    // `variant`: one void case (`empty`) and two payload cases of
    // different types (`circle`'s `u32`, `named`'s `string`), transformed
    // deterministically (`empty` -> `circle(1)`; `circle(r)` ->
    // `circle(r * 2)`; `named(s)` -> `named(s + "!")`) to prove real host
    // computation across every case, including the void one. `u32` (not
    // `f64`) is deliberately used for `circle`'s payload: mixing a float
    // payload with a same-slot non-float payload in one variant hits a
    // genuine, narrow, pre-existing bug in the pinned commit's shared
    // `wit_types.zig` flat calling convention (`joinCore` widens the
    // shared slot to `i64`, but neither `flatLift`/`coreSlotTo` nor
    // `fillFlat`/`setSlot` perform the bit-reinterpretation that widening
    // requires -- a genuine `error: canon: cannot widen f64 into i64`).
    // This is orthogonal to cataggar/wabt PR #335 (which fixed the
    // `--js-imports`-specific bindgen in component_bindgen.zig, not this
    // shared runtime helper) and would affect the export direction
    // identically for the same shape, so it is out of this integration's
    // scope; `u32`+`string` already proves discriminant-based dispatch
    // across heterogeneous payload types without depending on it.
    variant shape {
        empty,
        circle(u32),
        named(string),
    }
    identity-shape: func(s: shape) -> shape;

    // `result<T, E>`: both payload (`checked-div`, dividing by zero
    // yields `err(string)`) and a void-payload `ok` case
    // (`validate-non-negative`, `ok` carries nothing, `err` carries the
    // reason as a `string`) -- reverse-bridge imports never get
    // ComponentizeJS's top-level throw-means-err calling convention (that
    // is an *export* calling convention only; see js_dispatch.h and
    // component.js's doc comments), so both surface to JS as the ordinary
    // `{tag, val}` object, `val` omitted for the void `ok` case.
    checked-div: func(a: s32, b: s32) -> result<s32, string>;
    validate-non-negative: func(n: s32) -> result<_, string>;
}

// A world-level `use` imports these named types into `js-exports`. `alias`
// reaches the variant and then record in this source interface's scope; `point`
// deliberately has the same local WIT name as host's distinct `point`.
interface root-types {
    record point {
        x: u32,
        y: u32,
    }
    record inner {
        x: u32,
        y: u32,
    }
    variant outer {
        empty,
        item(inner),
    }
    type alias = outer;
}

interface api {
    record point {
        x: u32,
        y: u32,
    }

    run-add: func(a: s64, b: s64) -> s64;
    run-sum-list: func(xs: list<u64>) -> u64;
    run-greet: func(name: string) -> string;
    run-scale: func(x: u32, y: u32, factor: u32) -> point;
    // Calls the host `add` import multiple times, with different
    // arguments, from a single export invocation -- proving each call is
    // independently dispatched (not cached/memoized at the first call).
    run-repeated-add: func() -> list<s64>;
    // Lets JS's own call to a *host* function propagate a real wasm trap.
    run-boom: func() -> u32;
    // Calls the void host import `note` and reports whether JavaScript
    // observed exactly `undefined` (`note() === undefined`), then reports
    // the host-side counter via `note-count` so the test can independently
    // confirm the canonical-ABI import actually ran (not a no-op stub).
    run-note: func() -> bool;
    run-note-count: func() -> u32;

    // Root-function import coverage: arguments/results, repeated calls, a
    // void result observed as JavaScript `undefined`, and host trapping.
    run-root-add: func(value: u32) -> u32;
    run-root-repeated: func(value: u32) -> list<u32>;
    run-root-note: func() -> bool;
    run-root-note-count: func() -> u32;
    run-root-boom: func() -> u32;
    record root-coordinates {
        x: u32,
        y: u32,
    }
    record root-message {
        coordinate: root-coordinates,
        labels: list<string>,
    }
    variant root-response {
        accepted(root-message),
        rejected,
    }
    run-root-transform: func(value: root-message) -> root-response;
    record root-chain-inner {
        x: u32,
        y: u32,
    }
    variant root-chain-outer {
        empty,
        item(root-chain-inner),
    }
    run-root-chain: func(value: root-chain-outer) -> root-chain-outer;

    run-sum-nested-lists: func(rows: list<list<u32>>) -> u32;

    // -- advanced synchronous value types (requirement 5) --

    run-char: func(c: char) -> char;
    run-option-char: func(c: option<char>) -> option<char>;

    // Asserts `bytes instanceof Uint8Array` client-side (no host call
    // needed for the shape check itself; see component.js).
    run-bytes-is-uint8array: func(bytes: list<u8>) -> bool;
    run-sum-bytes: func(bytes: list<u8>) -> u32;
    run-xor-bytes: func(bytes: list<u8>, key: u8) -> list<u8>;
    run-optional-bytes: func(bytes: option<list<u8>>) -> option<list<u8>>;

    run-swap-tuple: func(t: tuple<u32, string>) -> tuple<string, u32>;

    enum color {
        red,
        green,
        blue,
    }
    run-color: func(c: color) -> color;
    run-option-color: func(c: option<color>) -> option<color>;

    flags permissions {
        read,
        write,
        execute,
    }
    run-permissions: func(p: permissions) -> permissions;
    run-option-permissions: func(p: option<permissions>) -> option<permissions>;

    variant shape {
        empty,
        circle(u32),
        named(string),
    }
    run-shape: func(s: shape) -> shape;

    // Top-level export return type: `result<T, E>` here DOES get
    // ComponentizeJS's throw-means-err calling convention (unlike the
    // `host` import direction above) -- see component.js.
    run-checked-div: func(a: s32, b: s32) -> result<s32, string>;
    run-validate-non-negative: func(n: s32) -> result<_, string>;
}

world js-exports {
    // ComponentizeJS 0.21 root-function mapping:
    //   import addOne from "add-one";
    // Each function becomes a distinct ESM module with a default export,
    // while the generated core wasm imports `$root` / the verbatim WIT name.
    // Named world-local root types exercise recursive lowering/lifting of a
    // record containing another record and a list, plus a variant alias.
    record root-coordinates {
        x: u32,
        y: u32,
    }
    record root-message {
        coordinate: root-coordinates,
        labels: list<string>,
    }
    variant root-response {
        accepted(root-message),
        rejected,
    }
    type root-response-alias = root-response;

    // `alias -> outer -> inner` must resolve and emit from root-types's
    // source scope. `point` also collides with host's independent type.
    use root-types.{alias, point};

    import add-one: func(value: u32) -> u32;
    import root-note: func();
    import root-note-count: func() -> u32;
    import root-boom: func() -> u32;
    import root-transform: func(value: root-message) -> root-response-alias;
    import root-chain: func(value: alias) -> alias;

    import host;
    export api;
}
