// wit-imports E2E fixture: a self-contained package declaring both a
// host-provided *imported* interface (`host`) and the fixture's own JS
// *exported* interface (`api`), used by tests/e2e/wit-imports/run.sh.
//
// This directory is deliberately isolated (no cross-package `use`) so it
// can be pointed at directly by both:
//   * `wasip3-bindgen --wit <this dir> --world js-exports --dispatch
//     js_dispatch --js-imports` (generates the Zig-side typed import
//     wrappers + the JS-callable reverse bridge for `host`, plus the
//     existing export-shell/dispatch codegen for `api`), and
//   * this fixture's own copy of the full `js-dispatch` world
//     (../js-dispatch.wit), which imports `test:wit-imports/host@1.2.3`
//     and exports `test:wit-imports/api@1.2.3` alongside the usual WASI
//     surface, so `wabt component embed --world js-dispatch` gives the
//     resulting component a genuine, Wasmtime-linkable custom import.
//
// `api` and `host` intentionally do NOT share the `point` record type via
// `use` -- each declares its own nominally-independent `record point`. The
// JS glue (run-scale in component.js) bridges between them dynamically by
// JS object shape (`{x, y}`), which is all js_dispatch's untyped
// encode_to_js/decode_from_js pair needs; no WIT-level type sharing across
// interfaces is required for two interfaces to interoperate through JS.
package test:wit-imports@1.2.3;

interface host {
    record point {
        x: u32,
        y: u32,
    }

    // Exact s64/u64 BigInt round trips through the reverse (import) bridge.
    add: func(a: s64, b: s64) -> s64;
    sum-list: func(xs: list<u64>) -> u64;

    // string lifting/lowering.
    greet: func(name: string) -> string;

    // A nested record argument/result.
    scale: func(p: point, factor: u32) -> point;

    // Always traps host-side; used to prove a real Wasmtime host trap
    // propagates all the way out through the JS import call and the
    // enclosing JS export call as a genuine wasm trap, not a catchable
    // JS exception.
    boom: func() -> u32;

    // A WIT import with no result: JavaScript must observe exactly
    // `undefined` from calling this (never `false`/`null` -- see
    // js_dispatch.h's `STARLING_JS_UNDEFINED`/js_dispatch.zig's
    // `NativeTag.undefined_`). `note-count` is a second, side-channel host
    // import that lets the test prove `note`'s host implementation
    // genuinely ran (its observable side effect: incrementing a host-side
    // counter) rather than merely returning without error.
    note: func();
    note-count: func() -> u32;

    // -- advanced synchronous value types (integration requirement 5: WIT
    // imports must support every synchronous type the native bridge
    // handles for exports -- char/bytes/tuple/enum/flags/variant/result/
    // nesting, see tests/compat/fixtures/advanced-types/ for the export
    // side of the same type set -- everywhere WABT's `--js-imports`
    // bindgen (cataggar/wabt) allows it). These reuse the exact same
    // encode_to_js/decode_from_js and STARLING_JS_* tagged-value bridge as
    // the export direction, just with the encode/decode roles reversed.
    //
    // Of that type set, only `list<list<u32>>` nesting is wired into this
    // E2E fixture. Everything else the native bridge supports for exports
    // -- `char`, `list<u8>` (bytes), `tuple`, `enum`, `flags`, `variant`,
    // `result<T,E>` -- hits one of two real bugs in the pinned
    // `cataggar/wabt` commit's `--js-imports` codegen, each empirically
    // confirmed against this fixture's own `wasip3-bindgen --js-imports`
    // invocation (and, for the second, a full `zig build`):
    //
    //   1. `char`/`tuple`/`enum`/`flags`/`variant`/`result<T,E>` are
    //      rejected outright by `nativeBridgeSupported` in
    //      component_bindgen.zig -- a conservative allow-list (bool/
    //      integers/f32/f64/string, list/option/record recursively) written
    //      before js_dispatch.zig grew encodeNative/decodeNative support
    //      for those shapes (in the independently-developed
    //      sync-value-parity branch). Its own doc comment anticipates
    //      exactly this ("keep this in sync ... if it ever grows"). E.g.:
    //        error: generating bindings for world 'js-exports': UnsupportedWitType
    //          imported function '...#identity-char': parameter 'c' has a WIT
    //          type not supported by the JS import bridge (bool/integers/f32/
    //          f64/string/option<T>/list<T>/record only -- resource, variant,
    //          enum, flags, tuple, result<T,E>, char, future/stream need a
    //          further WABT phase)
    //
    //   2. `list<u8>` (bytes) *passes* that gate (list/option recursion
    //      already covers a `u8` element type) but its generated import
    //      wrapper's parameter-lowering fast path (`lowerParams`'s `.list`
    //      arm in component_bindgen.zig) unconditionally emits `<param>.ptr`
    //      / `<param>.len`, assuming every `list<T>` Zig-side parameter is a
    //      bare `[]const T`. In `--dispatch` mode (the mode `--js-imports`
    //      always runs in) `zigType()` deliberately maps `list<u8>` one
    //      level deeper, to the wrapper struct `wit_types.ByteList = struct
    //      { bytes: []const u8 }` (so the JS bridge can tell a byte list
    //      apart from a bare `list<u32>`-like list at runtime -- see that
    //      struct's own doc comment), and `lowerParams` never accounts for
    //      that indirection. The result is a genuine Zig **compile error**
    //      (not a generation-time rejection) as soon as any function takes
    //      a bare `list<u8>` *parameter*: `error: no field named 'ptr' in
    //      struct 'wit_types.ByteList'`. (`list<u8>` used only as a
    //      *result* is unaffected: the indirect-result path lifts through
    //      the fully-generic, reflection-based `wit_types.lift`, which
    //      already round-trips `ByteList` correctly -- proven by this same
    //      pinned commit's own `Char/ByteList wrappers have the same
    //      canonical layout as their bare payload` unit test.)
    //
    // Both are narrow, well-understood, single-function-body fixes (no
    // codegen redesign: `emitImportWrapper`/`emitJsImportBridge` are
    // otherwise fully generic over the WIT type graph). A focused,
    // fully-tested (but, per this integration's "do not push/post"
    // constraint, unpublished) fix for both has been prepared for
    // cataggar/wabt -- see tests/compat/manifest.json's
    // `wit-imports-native-bridge-type-gate` known_deviation for the exact
    // branch/commit and root-cause/fix summary.

    // Nesting: a `list` of `list<u32>`s, proving composite-of-composite
    // types round-trip through the reverse bridge, not just single-level
    // types. Unlike a bare `list<u8>` (see the doc comment above this
    // function), no element of this type is ever wrapped in `ByteList`
    // (that wrapper only applies to a *direct* `list<u8>`, never a
    // `list<u32>` nested inside another `list`), so neither of the two
    // bugs described above applies here.
    sum-nested-lists: func(rows: list<list<u32>>) -> u32;
}

interface api {
    record point {
        x: u32,
        y: u32,
    }

    run-add: func(a: s64, b: s64) -> s64;
    run-sum-list: func(xs: list<u64>) -> u64;
    run-greet: func(name: string) -> string;
    run-scale: func(x: u32, y: u32, factor: u32) -> point;
    // Calls the host `add` import multiple times, with different
    // arguments, from a single export invocation -- proving each call is
    // independently dispatched (not cached/memoized at the first call).
    run-repeated-add: func() -> list<s64>;
    // Lets JS's own call to a *host* function propagate a real wasm trap.
    run-boom: func() -> u32;
    // Calls the void host import `note` and reports whether JavaScript
    // observed exactly `undefined` (`note() === undefined`), then reports
    // the host-side counter via `note-count` so the test can independently
    // confirm the canonical-ABI import actually ran (not a no-op stub).
    run-note: func() -> bool;
    run-note-count: func() -> u32;

    run-sum-nested-lists: func(rows: list<list<u32>>) -> u32;
}

world js-exports {
    import host;
    export api;
}
