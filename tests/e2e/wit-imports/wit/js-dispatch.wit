// Own copy of host-apis/wasi-0.2.10/wit/js-dispatch.wit for the
// tests/e2e/wit-imports fixture -- see run.sh. Deliberately NOT the shared
// file: this world additionally imports `test:wit-imports/host@1.2.3`, and
// that import must not leak into the shared js-dispatch world (every other
// suite -- default export 22/22, native-dispatch, compat 11/11 -- builds
// against the shared host-apis/wasi-0.2.10/wit/js-dispatch.wit unmodified;
// adding a real component-level import there would make Wasmtime require a
// host implementation for it in every one of those suites too, breaking
// requirement 6's "no default-behavior change for components with no
// custom imports"). Everything else here is identical to the shared file.
package local:bindings;

interface root-types {
  record point {
    x: u32,
    y: u32,
  }
  record inner {
    x: u32,
    y: u32,
  }
  variant outer {
    empty,
    item(inner),
  }
  type alias = outer;
}

world js-dispatch {
  import wasi:cli/environment@0.2.10;
  import wasi:cli/exit@0.2.10;
  import wasi:io/error@0.2.10;
  import wasi:io/poll@0.2.10;
  import wasi:io/streams@0.2.10;
  import wasi:cli/stdin@0.2.10;
  import wasi:cli/stdout@0.2.10;
  import wasi:cli/stderr@0.2.10;
  import wasi:cli/terminal-input@0.2.10;
  import wasi:cli/terminal-output@0.2.10;
  import wasi:cli/terminal-stdin@0.2.10;
  import wasi:cli/terminal-stdout@0.2.10;
  import wasi:cli/terminal-stderr@0.2.10;
  import wasi:clocks/monotonic-clock@0.2.10;
  import wasi:clocks/wall-clock@0.2.10;
  import wasi:clocks/timezone@0.2.10;
  import wasi:filesystem/types@0.2.10;
  import wasi:filesystem/preopens@0.2.10;
  import wasi:sockets/network@0.2.10;
  import wasi:sockets/instance-network@0.2.10;
  import wasi:sockets/udp@0.2.10;
  import wasi:sockets/udp-create-socket@0.2.10;
  import wasi:sockets/tcp@0.2.10;
  import wasi:sockets/tcp-create-socket@0.2.10;
  import wasi:sockets/ip-name-lookup@0.2.10;
  import wasi:random/random@0.2.10;
  import wasi:random/insecure@0.2.10;
  import wasi:random/insecure-seed@0.2.10;
  import wasi:http/types@0.2.10;
  import wasi:http/outgoing-handler@0.2.10;

  // The custom WIT interface import this fixture exercises -- resolved via
  // deps/test-wit-imports/package.wit, versioned per ComponentizeJS-style
  // module-specifier conventions.
  import test:wit-imports/host@1.2.3;

  // World-level function imports. The generated core wasm imports these from
  // `$root`; ComponentizeJS-compatible JavaScript sees one default-export
  // module per function (`import addOne from "add-one"`, etc.).
  record root-coordinates {
    x: u32,
    y: u32,
  }
  record root-message {
    coordinate: root-coordinates,
    labels: list<string>,
  }
  variant root-response {
    accepted(root-message),
    rejected,
  }
  type root-response-alias = root-response;

  use root-types.{alias, point};

  import add-one: func(value: u32) -> u32;
  import root-note: func();
  import root-note-count: func() -> u32;
  import root-boom: func() -> u32;
  import root-transform: func(value: root-message) -> root-response-alias;
  import root-chain: func(value: alias) -> alias;

  export wasi:cli/run@0.2.10;
  export wasi:http/incoming-handler@0.2.10;
  export test:wit-imports/api@1.2.3;
}
