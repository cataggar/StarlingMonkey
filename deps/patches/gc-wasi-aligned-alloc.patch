+#ifdef __wasi__
+// Zig's wasi-libc posix_memalign() does not honor alignments larger than the
+// wasm page size (64 KiB), but the GC needs ChunkSize (1 MiB) aligned chunks.
+// Over-allocate and align manually, stashing the base pointer just before the
+// returned region so WasiAlignedFree() can recover it.
+static inline void* WasiAlignedAlloc(size_t alignment, size_t length) {
+  void* base = malloc(length + alignment + sizeof(void*));
+  if (!base) {
+    return nullptr;
+  }
+  uintptr_t aligned =
+      (uintptr_t(base) + sizeof(void*) + alignment - 1) & ~(alignment - 1);
+  reinterpret_cast<void**>(aligned)[-1] = base;
+  return reinterpret_cast<void*>(aligned);
+}
+
+static inline void WasiAlignedFree(void* region) {
+  if (region) {
+    free(reinterpret_cast<void**>(region)[-1]);
+  }
+}
+#endif
